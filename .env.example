# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# OpenAI API Key (REQUIRED)
# Get your key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Data directory (OPTIONAL)
# Default: ./processed_data
# Set this if your processed data is in a different location
DATA_DIR=./processed_data

# Raw data path (OPTIONAL)
# Default: ../raw_dataset
# Used by dataset_ablation experiments
RAW_DATA_PATH=../raw_dataset

# GPU Device (OPTIONAL)
# Default: cpu
# Set to 'cuda' if you have NVIDIA GPU, or 'mps' for Apple Silicon
DEVICE=cpu
